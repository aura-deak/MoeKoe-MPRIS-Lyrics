#!/usr/bin/env bash
# 发布打 tag 的唯一入口：先改 manifest.json 版本号并提交，最后才创建 tag。
#
# 用法：
#   scripts/release-tag v3.0.0
#
# 为什么需要它：git 没有「创建 tag」的 hook，无法在打 tag 时自动改文件；
# 而发布流水线（release.yml）要求 tag 与 manifest.json 的 version 一致。
# 配套的 .githooks/pre-push 会拒绝推送与 manifest 不一致的 tag，
# 所以裸 `git tag vX.Y.Z` 打出来的 tag 推不上去，必须走本脚本。

set -euo pipefail

TAG="${1:?用法: scripts/release-tag vX.Y.Z}"

if [[ ! "$TAG" =~ ^v[0-9]+(\.[0-9]+){1,3}$ ]]; then
  echo "错误: tag 必须匹配 vX.X / vX.X.X / vX.X.X.X，得到: $TAG" >&2
  exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
  echo "错误: 工作区有未提交改动，先提交或暂存(stash)，否则版本提交会卷入无关内容：" >&2
  git status --short >&2
  exit 1
fi

if git rev-parse -q --verify "refs/tags/$TAG" >/dev/null; then
  echo "错误: tag $TAG 已存在" >&2
  exit 1
fi

VERSION="${TAG#v}"

# 用 python 改 JSON，保证格式合法（保持 2 空格缩进 + 尾部换行）
python3 - "$VERSION" <<'PY'
import json, sys

path = "manifest.json"
with open(path, encoding="utf-8") as f:
    manifest = json.load(f)

old = manifest.get("version")
manifest["version"] = sys.argv[1]

with open(path, "w", encoding="utf-8") as f:
    json.dump(manifest, f, indent=2, ensure_ascii=False)
    f.write("\n")

print(f"manifest.json: version {old} -> {manifest['version']}")
PY

git add manifest.json
git commit -m "chore(release): $TAG"
git tag -a "$TAG" -m "$TAG"

echo
echo "完成: $TAG -> manifest version=$VERSION"
echo "推送: git push origin main --follow-tags"
