#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""MoeKoe Music MPRIS 桥接器

把 MoeKoe WebSocket API 的曲目与播放状态桥接到标准 MPRIS2 D-Bus 接口，
并把 MPRIS Player 控制方法反向桥接到 MoeKoe WebSocket。

只暴露标准 MPRIS 接口：
    org.mpris.MediaPlayer2            根接口（最小可用）
    org.mpris.MediaPlayer2.Player     播放状态 / Metadata / Position / 控制

MoeKoe WebSocket API 只开放 toggle / next / prev 三个控制命令，因此
Seek / SetPosition / OpenUri 以及 Root 的 Raise / Quit 未实现。

入站（MoeKoe 桥接页 -> 本程序，JSON Lines over stdin）：
    {"type":"message","payload":{...}}
    {"type":"shutdown"}

payload 类型：
    hello             桥接页握手
    track             曲目元数据 + 时长 + 进度 + 播放状态
    status            播放状态与进度（附带桥接页快照）
    position          仅进度校正
    status-request    请求宿主合并状态回执（给弹窗）
    bridge-command    中继指令（reconnect / push-all）
    ping              心跳

出站（本程序 -> 桥接页，JSON Lines over stdout）：
    ready / error / pong / status / bridge-command / control / bye

日志一律写 stderr，stdout 只输出 JSON Lines。
"""

from __future__ import annotations

import json
import os
import re
import shlex
import sys
import threading
import time

PROTOCOL = 1
DBUS_NAME = "org.mpris.MediaPlayer2.MoeKoeMusic"
OBJECT_PATH = "/org/mpris/MediaPlayer2"

IFACE_ROOT = "org.mpris.MediaPlayer2"
IFACE_PLAYER = "org.mpris.MediaPlayer2.Player"
IFACE_PROPS = "org.freedesktop.DBus.Properties"

_stdout_lock = threading.Lock()
_quit_flag = {"value": False}
_main_loop = {"obj": None}

try:  # pragma: no cover - 依赖缺失时降级运行
    import dbus
    import dbus.exceptions
    import dbus.service
    from dbus.mainloop.glib import DBusGMainLoop
    from gi.repository import GLib

    DBUS_AVAILABLE = True
    DBUS_IMPORT_ERROR = ""
except Exception as exc:  # noqa: BLE001 - 需要把具体缺失原因告诉用户
    DBUS_AVAILABLE = False
    DBUS_IMPORT_ERROR = str(exc)


# --------------------------------------------------------------------------
# 标准输出 / 日志
# --------------------------------------------------------------------------

def emit(payload):
    """向 stdout 写一行 JSON（MoeKoe 会转发给桥接页）。"""
    line = json.dumps(payload, ensure_ascii=False)
    with _stdout_lock:
        try:
            sys.stdout.write(line + "\n")
            sys.stdout.flush()
        except Exception:  # noqa: BLE001 - 管道已关闭时直接放弃
            pass


def log(message):
    try:
        sys.stderr.write("[mpris-host] %s\n" % message)
        sys.stderr.flush()
    except Exception:  # noqa: BLE001
        pass


# --------------------------------------------------------------------------
# 启动包装自动修复（规避 Electron chromium 重复注册 MPRIS）
# --------------------------------------------------------------------------

LAUNCHER_FEATURE_FLAG = "--disable-features=MediaSessionService"
LAUNCHER_PATH = os.path.join(
    os.path.expanduser("~"), ".local", "bin", "moekoemusic"
)


def find_moe_koe_exec():
    """定位真正的 MoeKoe 可执行入口（跳过我们自己的启动包装）。"""
    for candidate in (
        "/usr/bin/moekoemusic",
        "/usr/local/bin/moekoemusic",
        "/opt/moekoemusic/moekoemusic",
        "/opt/MoeKoeMusic/moekoemusic",
    ):
        if os.path.isfile(candidate):
            return candidate, None
    # 兜底：从系统 .desktop 的 Exec= 反查
    for directory in ("/usr/share/applications", "/usr/local/share/applications"):
        try:
            names = os.listdir(directory)
        except OSError:
            continue
        for name in sorted(names):
            if not name.endswith(".desktop"):
                continue
            path = os.path.join(directory, name)
            try:
                with open(path, encoding="utf-8", errors="replace") as fh:
                    content = fh.read()
            except OSError:
                continue
            exec_line = ""
            for line in content.splitlines():
                if line.startswith("Exec="):
                    exec_line = line[5:].strip()
                    break
            if "moekoemusic" not in exec_line.lower():
                continue
            fields = exec_line.split()
            if fields and os.path.isfile(fields[0]):
                return fields[0], (path, content)
            return None, (path, content)
    return None, None


def read_desktop_source():
    """找到系统的 moekoemusic.desktop 以便生成用户级覆盖。"""
    for directory in ("/usr/share/applications", "/usr/local/share/applications"):
        path = os.path.join(directory, "moekoemusic.desktop")
        try:
            with open(path, encoding="utf-8", errors="replace") as fh:
                return path, fh.read()
        except OSError:
            continue
    return None, None


def fix_launcher():
    """创建/更新带 MediaSessionService 禁用 flag 的启动包装。返回结果 dict。"""
    # type 字段供弹窗按 message.type 分派（缺了它会静默超时）
    result = {"type": "fix-launcher-result"}

    real, desktop_pair = find_moe_koe_exec()
    if real is None:
        if desktop_pair is None:
            result.update(
                ok=False,
                message="未找到 MoeKoe Music 可执行文件（/usr/bin/moekoemusic 不存在，且没有相关 .desktop）",
            )
            return result
        # desktop 里有 Exec 但指向不存在的裸命令名（PATH 由菜单环境决定），
        # 包装里仍然写裸命令名让菜单环境自己解析
        exec_line = ""
        for line in desktop_pair[1].splitlines():
            if line.startswith("Exec="):
                exec_line = line[5:].strip()
                break
        fields = exec_line.split()
        real = fields[0].strip('"') if fields else "moekoemusic"

    already = False
    if os.path.isfile(LAUNCHER_PATH):
        try:
            with open(LAUNCHER_PATH, encoding="utf-8", errors="replace") as fh:
                already = LAUNCHER_FEATURE_FLAG in fh.read()
        except OSError:
            pass

    script = (
        "#!/bin/sh\n"
        "# 由 MoeKoe MPRIS 插件自动生成：禁用 Electron 内置 MediaSession MPRIS，\n"
        "# 避免 chromium.instance* 与扩展的 mpris-host 重复注册（前者抢在前面且无歌词）。\n"
        "exec %s %s \"$@\"\n" % (shlex.quote(real), LAUNCHER_FEATURE_FLAG)
    )
    try:
        os.makedirs(os.path.dirname(LAUNCHER_PATH), exist_ok=True)
        with open(LAUNCHER_PATH, "w", encoding="utf-8") as fh:
            fh.write(script)
        os.chmod(LAUNCHER_PATH, 0o755)
    except OSError as exc:
        result.update(ok=False, message="写入启动包装 %s 失败: %s" % (LAUNCHER_PATH, exc))
        return result

    notes = []
    # 同步覆盖应用菜单启动项（用户级，优先于系统 .desktop）
    if desktop_pair is None:
        _, desktop_content = read_desktop_source()
        desktop_pair = ("moekoemusic.desktop", desktop_content) if desktop_content else None
    if desktop_pair:
        src_path, content = desktop_pair
        name = os.path.basename(src_path)
        override_dir = os.path.join(
            os.path.expanduser("~"), ".local", "share", "applications"
        )
        try:
            os.makedirs(override_dir, exist_ok=True)
            lines = []
            for line in content.splitlines():
                if line.startswith("Exec="):
                    lines.append("Exec=%s %%U" % LAUNCHER_PATH)
                elif line.startswith("TryExec="):
                    continue
                else:
                    lines.append(line)
            with open(os.path.join(override_dir, name), "w", encoding="utf-8") as fh:
                fh.write("\n".join(lines) + "\n")
            notes.append("应用菜单启动项已覆盖（%s）" % name)
        except OSError:
            notes.append("应用菜单启动项覆盖失败，可手动把 .desktop 的 Exec 改为 %s" % LAUNCHER_PATH)
    else:
        notes.append("未找到系统 .desktop，若从菜单启动请手动把 Exec 改为 %s" % LAUNCHER_PATH)

    # PATH 检查：命令行敲 moekoemusic 时包装是否优先于真实二进制
    parts = os.environ.get("PATH", "").split(os.pathsep)
    if LAUNCHER_PATH.rsplit(os.sep, 1)[0] in parts:
        real_dir = os.path.dirname(real) if os.sep in real else ""
        if real_dir and parts.index(LAUNCHER_PATH.rsplit(os.sep, 1)[0]) > parts.index(real_dir):
            notes.append(
                "PATH 中 ~/.local/bin 排在 %s 之后，命令行启动不会走包装，请调整 PATH 顺序" % real_dir
            )
    else:
        notes.append(
            'PATH 不含 ~/.local/bin，命令行启动不会走包装：请在 shell 配置中加 export PATH="$HOME/.local/bin:$PATH"'
        )

    verb = "启动包装已就绪" if already else "已创建启动包装"
    result.update(
        ok=True,
        message="%s（%s）。%s。完全退出并重启 MoeKoe 后生效。"
        % (verb, LAUNCHER_PATH, "；".join(notes)),
    )
    return result


def unfix_launcher():
    """撤销 fix_launcher 的改动：删除启动包装与菜单覆盖，卸载插件前必须运行。

    安全原则：只清理本插件生成的内容 ——
      * 启动包装仅在内容含本插件标记（flag / 注释）时删除，用户自建脚本不碰；
      * 菜单覆盖仅在 Exec 指向本插件启动包装时删除，其他覆盖文件不碰。
    """
    result = {"type": "unfix-launcher-result"}
    notes = []

    # 1) 删除启动包装
    if os.path.isfile(LAUNCHER_PATH):
        try:
            with open(LAUNCHER_PATH, encoding="utf-8", errors="replace") as fh:
                content = fh.read()
            if LAUNCHER_FEATURE_FLAG in content or "MoeKoe MPRIS" in content:
                os.remove(LAUNCHER_PATH)
                notes.append("已删除启动包装 %s" % LAUNCHER_PATH)
            else:
                notes.append("启动包装 %s 不是本插件生成的，未改动" % LAUNCHER_PATH)
        except OSError as exc:
            result.update(ok=False, message="读取/删除启动包装 %s 失败: %s" % (LAUNCHER_PATH, exc))
            return result
    else:
        notes.append("启动包装不存在（%s）" % LAUNCHER_PATH)

    # 2) 删除应用菜单覆盖（用户级 .desktop）
    override_dir = os.path.join(
        os.path.expanduser("~"), ".local", "share", "applications"
    )
    removed_desktop = False
    if os.path.isdir(override_dir):
        try:
            names = os.listdir(override_dir)
        except OSError:
            names = []
        for name in sorted(names):
            if not name.endswith(".desktop"):
                continue
            path = os.path.join(override_dir, name)
            try:
                with open(path, encoding="utf-8", errors="replace") as fh:
                    content = fh.read()
            except OSError:
                continue
            if LAUNCHER_PATH not in content:
                continue
            try:
                os.remove(path)
                removed_desktop = True
                notes.append("已删除应用菜单覆盖（%s），恢复使用系统启动项" % name)
            except OSError as exc:
                notes.append("删除应用菜单覆盖 %s 失败: %s" % (path, exc))
    if not removed_desktop:
        notes.append("没有需要清理的应用菜单覆盖")

    notes.append("插件已恢复原状，现在可以安全卸载本插件")
    result.update(ok=True, message="撤销完成：%s。" % "；".join(notes))
    return result


# --------------------------------------------------------------------------
# 播放状态
# --------------------------------------------------------------------------

class PlayerState:
    def __init__(self):
        self.bridge_status = {}      # 桥接页最近一次全量快照（弹窗状态的数据源）
        self.bridge_status_at = 0.0
        self.status = "Stopped"
        self.track = {}
        self.track_key = ""
        self.track_id = OBJECT_PATH + "/Track/none"
        self.duration_us = 0
        self.position_us = 0
        self.anchor = time.monotonic()
        # xesam:asText 配置
        self.asTextFormat = 'lrc'    # 'plain' | 'lrc'
        self.asTextSource = 'original' # 'original' | 'translation'
        self.asTextApiFallback = False # 翻译模式取不到翻译时是否走 Bilibili API 翻译 

    # ---- 进度 ----
    def set_position_seconds(self, seconds):
        try:
            value = float(seconds or 0)
        except (TypeError, ValueError):
            value = 0.0
        self.position_us = max(int(value * 1_000_000), 0)
        self.anchor = time.monotonic()

    def current_position_us(self):
        value = self.position_us
        if self.status == "Playing":
            value += int((time.monotonic() - self.anchor) * 1_000_000)
        if self.duration_us > 0:
            value = min(value, self.duration_us)
        return max(value, 0)

    def set_status(self, status, position=None):
        if status not in ("Playing", "Paused", "Stopped"):
            return
        changed = status != self.status
        if position is not None:
            self.set_position_seconds(position)
        else:
            self.anchor = time.monotonic()
        self.status = status
        return changed


def make_track_id(track):
    raw = str(track.get("id") or track.get("title") or "unknown")
    safe = re.sub(r"[^A-Za-z0-9_]", "_", raw)[:64]
    if not safe:
        safe = "unknown"
    if safe[0].isdigit():
        safe = "T_" + safe
    return "%s/Track/%s" % (OBJECT_PATH, safe)


# --------------------------------------------------------------------------
# D-Bus 类型转换
# --------------------------------------------------------------------------
#
# dbus-python 没有 dbus.Variant 类型：只要声明了签名（如 a{sv}、v），
# 普通 Python 值 / dbus 类型会在封送时自动包装成 Variant。

def to_variant_dict(data):
    out = dbus.Dictionary(signature="sv")
    for key, value in dict(data or {}).items():
        out[str(key)] = plain_value(value)
    return out


_DBUS_TYPES_CACHE = None


def dbus_types():
    """已在进程内转换好的 D-Bus 类型集合（缺失绑定时不会走到这里）。"""
    global _DBUS_TYPES_CACHE
    if _DBUS_TYPES_CACHE is None:
        _DBUS_TYPES_CACHE = tuple(
            getattr(dbus, name)
            for name in (
                "Boolean", "Int32", "Int64", "Double", "String",
                "ObjectPath", "Dictionary", "Array", "Signature",
            )
            if getattr(dbus, name, None) is not None
        )
    return _DBUS_TYPES_CACHE


def plain_value(value):
    if isinstance(value, dbus_types()):
        return value
    if isinstance(value, bool):
        return dbus.Boolean(value)
    if isinstance(value, int):
        if -2 ** 31 <= value < 2 ** 31:
            return dbus.Int32(value)
        return dbus.Int64(value)
    if isinstance(value, float):
        return dbus.Double(value)
    if isinstance(value, str):
        return dbus.String(value)
    if isinstance(value, dict):
        return to_variant_dict(value)
    if isinstance(value, (list, tuple)):
        return dbus.Array([plain_value(item) for item in value], signature="v")
    if value is None:
        return dbus.String("")
    return dbus.String(str(value))


def typed(signature, value):
    """按声明签名把 Python 值包装成对应的 dbus 类型。"""
    if signature == "b":
        return dbus.Boolean(bool(value))
    if signature == "i":
        return dbus.Int32(int(value))
    if signature == "x":
        return dbus.Int64(int(value))
    if signature == "d":
        return dbus.Double(float(value))
    if signature == "s":
        return dbus.String(str(value))
    if signature == "o":
        return dbus.ObjectPath(str(value))
    if signature == "as":
        return dbus.Array([dbus.String(str(item)) for item in (value or [])], signature="s")
    if signature == "a{sv}":
        if isinstance(value, dbus.Dictionary):
            return value
        return to_variant_dict(value)
    if signature == "v":
        return plain_value(value)
    return value


# --------------------------------------------------------------------------
# 属性表
# --------------------------------------------------------------------------

def root_properties():
    return {
        "CanQuit": ("b", False),
        "CanRaise": ("b", False),
        "HasTrackList": ("b", False),
        "Identity": ("s", "MoeKoe Music"),
        "SupportedUriSchemes": ("as", []),
        "SupportedMimeTypes": ("as", []),
    }


def player_properties(state):
    return {
        "PlaybackStatus": ("s", state.status),
        "LoopStatus": ("s", "None"),
        "Rate": ("d", 1.0),
        "Shuffle": ("b", False),
        "Metadata": ("a{sv}", build_metadata(state)),
        "Volume": ("d", 1.0),
        "Position": ("x", state.current_position_us()),
        "MinimumRate": ("d", 1.0),
        "MaximumRate": ("d", 1.0),
        "CanGoNext": ("b", True),
        "CanGoPrevious": ("b", True),
        "CanPlay": ("b", True),
        "CanPause": ("b", True),
        "CanSeek": ("b", False),
        "CanControl": ("b", True),
    }


def build_metadata(state):
    metadata = dbus.Dictionary(signature="sv")
    if not state.track:
        return metadata

    metadata["mpris:trackid"] = dbus.ObjectPath(state.track_id)
    if state.duration_us > 0:
        metadata["mpris:length"] = dbus.Int64(state.duration_us)

    title = str(state.track.get("title") or "")
    if title:
        metadata["xesam:title"] = dbus.String(title)

    artists = [str(item) for item in (state.track.get("artists") or []) if item]
    if artists:
        metadata["xesam:artist"] = dbus.Array([dbus.String(a) for a in artists], signature="s")

    album = str(state.track.get("album") or "")
    if album:
        metadata["xesam:album"] = dbus.String(album)

    # xesam:asText —— 歌词全文（Xesam 规范：String 类型）
    lyrics = state.track.get("lyrics") or ""
    if lyrics:
        metadata["xesam:asText"] = dbus.String(lyrics)

    # xesam:lyricist —— 作词人（Xesam 规范：字符串数组）
    lyricist_val = state.track.get("lyricist") or []
    if isinstance(lyricist_val, str):
        lyricist_val = [lyricist_val]
    lyricists = [str(item) for item in lyricist_val if item]
    if lyricists:
        metadata["xesam:lyricist"] = dbus.Array(
            [dbus.String(a) for a in lyricists], signature="s"
        )

    art = str(state.track.get("artUrl") or "")
    if art.startswith(("http://", "https://", "file://")):
        metadata["mpris:artUrl"] = dbus.String(art)

    url = str(state.track.get("url") or "")
    if url.startswith(("http://", "https://", "file://")):
        metadata["xesam:url"] = dbus.String(url)

    return metadata


# --------------------------------------------------------------------------
# Introspection
# --------------------------------------------------------------------------

INTROSPECT_XML = """<node>
  <interface name="org.freedesktop.DBus.Introspectable">
    <method name="Introspect">
      <arg type="s" name="xml_data" direction="out"/>
