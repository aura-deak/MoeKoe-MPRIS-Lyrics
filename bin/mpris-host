#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""MoeKoe Music MPRIS 桥接器

把 MoeKoe WebSocket API 的曲目与播放状态桥接到标准 MPRIS2 D-Bus 接口，
并把 MPRIS Player 控制方法反向桥接到 MoeKoe WebSocket。

只暴露标准 MPRIS 接口：
    org.mpris.MediaPlayer2            根接口（最小可用）
    org.mpris.MediaPlayer2.Player     播放状态 / Metadata / Position / 控制

MoeKoe WebSocket API 只开放 toggle / next / prev 三个控制命令，因此
Seek / SetPosition / OpenUri 以及 Root 的 Raise / Quit 未实现。

入站（MoeKoe 桥接页 -> 本程序，JSON Lines over stdin）：
    {"type":"message","payload":{...}}
    {"type":"shutdown"}

payload 类型：
    hello             桥接页握手
    track             曲目元数据 + 时长 + 进度 + 播放状态
    status            播放状态与进度（附带桥接页快照）
    position          仅进度校正
    status-request    请求宿主合并状态回执（给弹窗）
    bridge-command    中继指令（reconnect / push-all）
    ping              心跳

出站（本程序 -> 桥接页，JSON Lines over stdout）：
    ready / error / pong / status / bridge-command / control / bye

日志一律写 stderr，stdout 只输出 JSON Lines。
"""

from __future__ import annotations

import json
import os
import re
import sys
import threading
import time

PROTOCOL = 1
DBUS_NAME = "org.mpris.MediaPlayer2.MoeKoeMusic"
OBJECT_PATH = "/org/mpris/MediaPlayer2"

IFACE_ROOT = "org.mpris.MediaPlayer2"
IFACE_PLAYER = "org.mpris.MediaPlayer2.Player"
IFACE_PROPS = "org.freedesktop.DBus.Properties"

_stdout_lock = threading.Lock()
_quit_flag = {"value": False}
_main_loop = {"obj": None}

try:  # pragma: no cover - 依赖缺失时降级运行
    import dbus
    import dbus.exceptions
    import dbus.service
    from dbus.mainloop.glib import DBusGMainLoop
    from gi.repository import GLib

    DBUS_AVAILABLE = True
    DBUS_IMPORT_ERROR = ""
except Exception as exc:  # noqa: BLE001 - 需要把具体缺失原因告诉用户
    DBUS_AVAILABLE = False
    DBUS_IMPORT_ERROR = str(exc)


# --------------------------------------------------------------------------
# 标准输出 / 日志
# --------------------------------------------------------------------------

def emit(payload):
    """向 stdout 写一行 JSON（MoeKoe 会转发给桥接页）。"""
    line = json.dumps(payload, ensure_ascii=False)
    with _stdout_lock:
        try:
            sys.stdout.write(line + "\n")
            sys.stdout.flush()
        except Exception:  # noqa: BLE001 - 管道已关闭时直接放弃
            pass


def log(message):
    try:
        sys.stderr.write("[mpris-host] %s\n" % message)
        sys.stderr.flush()
    except Exception:  # noqa: BLE001
        pass


# --------------------------------------------------------------------------
# 播放状态
# --------------------------------------------------------------------------

class PlayerState:
    def __init__(self):
        self.bridge_status = {}      # 桥接页最近一次全量快照（弹窗状态的数据源）
        self.bridge_status_at = 0.0
        self.status = "Stopped"
        self.track = {}
        self.track_key = ""
        self.track_id = OBJECT_PATH + "/Track/none"
        self.duration_us = 0
        self.position_us = 0
        self.anchor = time.monotonic()

    # ---- 进度 ----
    def set_position_seconds(self, seconds):
        try:
            value = float(seconds or 0)
        except (TypeError, ValueError):
            value = 0.0
        self.position_us = max(int(value * 1_000_000), 0)
        self.anchor = time.monotonic()

    def current_position_us(self):
        value = self.position_us
        if self.status == "Playing":
            value += int((time.monotonic() - self.anchor) * 1_000_000)
        if self.duration_us > 0:
            value = min(value, self.duration_us)
        return max(value, 0)

    def set_status(self, status, position=None):
        if status not in ("Playing", "Paused", "Stopped"):
            return
        changed = status != self.status
        if position is not None:
            self.set_position_seconds(position)
        else:
            self.anchor = time.monotonic()
        self.status = status
        return changed


def make_track_id(track):
    raw = str(track.get("id") or track.get("title") or "unknown")
    safe = re.sub(r"[^A-Za-z0-9_]", "_", raw)[:64]
    if not safe:
        safe = "unknown"
    if safe[0].isdigit():
        safe = "T_" + safe
    return "%s/Track/%s" % (OBJECT_PATH, safe)


# --------------------------------------------------------------------------
# D-Bus 类型转换
# --------------------------------------------------------------------------
#
# dbus-python 没有 dbus.Variant 类型：只要声明了签名（如 a{sv}、v），
# 普通 Python 值 / dbus 类型会在封送时自动包装成 Variant。

def to_variant_dict(data):
    out = dbus.Dictionary(signature="sv")
    for key, value in dict(data or {}).items():
        out[str(key)] = plain_value(value)
    return out


_DBUS_TYPES_CACHE = None


def dbus_types():
    """已在进程内转换好的 D-Bus 类型集合（缺失绑定时不会走到这里）。"""
    global _DBUS_TYPES_CACHE
    if _DBUS_TYPES_CACHE is None:
        _DBUS_TYPES_CACHE = tuple(
            getattr(dbus, name)
            for name in (
                "Boolean", "Int32", "Int64", "Double", "String",
                "ObjectPath", "Dictionary", "Array", "Signature",
            )
            if getattr(dbus, name, None) is not None
        )
    return _DBUS_TYPES_CACHE


def plain_value(value):
    if isinstance(value, dbus_types()):
        return value
    if isinstance(value, bool):
        return dbus.Boolean(value)
    if isinstance(value, int):
        if -2 ** 31 <= value < 2 ** 31:
            return dbus.Int32(value)
        return dbus.Int64(value)
    if isinstance(value, float):
        return dbus.Double(value)
    if isinstance(value, str):
        return dbus.String(value)
    if isinstance(value, dict):
        return to_variant_dict(value)
    if isinstance(value, (list, tuple)):
        return dbus.Array([plain_value(item) for item in value], signature="v")
    if value is None:
        return dbus.String("")
    return dbus.String(str(value))


def typed(signature, value):
    """按声明签名把 Python 值包装成对应的 dbus 类型。"""
    if signature == "b":
        return dbus.Boolean(bool(value))
    if signature == "i":
        return dbus.Int32(int(value))
    if signature == "x":
        return dbus.Int64(int(value))
    if signature == "d":
        return dbus.Double(float(value))
    if signature == "s":
        return dbus.String(str(value))
    if signature == "o":
        return dbus.ObjectPath(str(value))
    if signature == "as":
        return dbus.Array([dbus.String(str(item)) for item in (value or [])], signature="s")
    if signature == "a{sv}":
        if isinstance(value, dbus.Dictionary):
            return value
        return to_variant_dict(value)
    if signature == "v":
        return plain_value(value)
    return value


# --------------------------------------------------------------------------
# 属性表
# --------------------------------------------------------------------------

def root_properties():
    return {
        "CanQuit": ("b", False),
        "CanRaise": ("b", False),
        "HasTrackList": ("b", False),
        "Identity": ("s", "MoeKoe Music"),
        "SupportedUriSchemes": ("as", []),
        "SupportedMimeTypes": ("as", []),
    }


def player_properties(state):
    return {
        "PlaybackStatus": ("s", state.status),
        "LoopStatus": ("s", "None"),
        "Rate": ("d", 1.0),
        "Shuffle": ("b", False),
        "Metadata": ("a{sv}", build_metadata(state)),
        "Volume": ("d", 1.0),
        "Position": ("x", state.current_position_us()),
        "MinimumRate": ("d", 1.0),
        "MaximumRate": ("d", 1.0),
        "CanGoNext": ("b", True),
        "CanGoPrevious": ("b", True),
        "CanPlay": ("b", True),
        "CanPause": ("b", True),
        "CanSeek": ("b", False),
        "CanControl": ("b", True),
    }


def build_metadata(state):
    metadata = dbus.Dictionary(signature="sv")
    if not state.track:
        return metadata

    metadata["mpris:trackid"] = dbus.ObjectPath(state.track_id)
    if state.duration_us > 0:
        metadata["mpris:length"] = dbus.Int64(state.duration_us)

    title = str(state.track.get("title") or "")
    if title:
        metadata["xesam:title"] = dbus.String(title)

    artists = [str(item) for item in (state.track.get("artists") or []) if item]
    if artists:
        metadata["xesam:artist"] = dbus.Array([dbus.String(a) for a in artists], signature="s")

    album = str(state.track.get("album") or "")
    if album:
        metadata["xesam:album"] = dbus.String(album)

    art = str(state.track.get("artUrl") or "")
    if art.startswith(("http://", "https://", "file://")):
        metadata["mpris:artUrl"] = dbus.String(art)

    url = str(state.track.get("url") or "")
    if url.startswith(("http://", "https://", "file://")):
        metadata["xesam:url"] = dbus.String(url)

    return metadata


# --------------------------------------------------------------------------
# Introspection
# --------------------------------------------------------------------------

INTROSPECT_XML = """<node>
  <interface name="org.freedesktop.DBus.Introspectable">
    <method name="Introspect">
      <arg type="s" name="xml_data" direction="out"/>
    </method>
  </interface>
  <interface name="org.mpris.MediaPlayer2">
    <method name="Raise"/>
    <method name="Quit"/>
    <property name="CanQuit" type="b" access="read"/>
    <property name="CanRaise" type="b" access="read"/>
    <property name="HasTrackList" type="b" access="read"/>
    <property name="Identity" type="s" access="read"/>
    <property name="SupportedUriSchemes" type="as" access="read"/>
    <property name="SupportedMimeTypes" type="as" access="read"/>
  </interface>
  <interface name="org.mpris.MediaPlayer2.Player">
    <method name="Next"/>
    <method name="Previous"/>
    <method name="Pause"/>
    <method name="PlayPause"/>
    <method name="Stop"/>
    <method name="Play"/>
    <method name="Seek">
      <arg name="Offset" type="x" direction="in"/>
    </method>
    <method name="SetPosition">
      <arg name="TrackId" type="o" direction="in"/>
      <arg name="Position" type="x" direction="in"/>
    </method>
    <method name="OpenUri">
      <arg name="Uri" type="s" direction="in"/>
    </method>
    <property name="PlaybackStatus" type="s" access="read"/>
    <property name="LoopStatus" type="s" access="read"/>
    <property name="Rate" type="d" access="read"/>
    <property name="Shuffle" type="b" access="read"/>
    <property name="Metadata" type="a{sv}" access="read"/>
    <property name="Volume" type="d" access="read"/>
    <property name="Position" type="x" access="read"/>
    <property name="MinimumRate" type="d" access="read"/>
    <property name="MaximumRate" type="d" access="read"/>
    <property name="CanGoNext" type="b" access="read"/>
    <property name="CanGoPrevious" type="b" access="read"/>
    <property name="CanPlay" type="b" access="read"/>
    <property name="CanPause" type="b" access="read"/>
    <property name="CanSeek" type="b" access="read"/>
    <property name="CanControl" type="b" access="read"/>
  </interface>
  <interface name="org.freedesktop.DBus.Properties">
    <method name="Get">
      <arg name="interface_name" type="s" direction="in"/>
      <arg name="property" type="s" direction="in"/>
      <arg name="value" type="v" direction="out"/>
    </method>
    <method name="Set">
      <arg name="interface_name" type="s" direction="in"/>
      <arg name="property" type="s" direction="in"/>
      <arg name="value" type="v" direction="in"/>
    </method>
    <method name="GetAll">
      <arg name="interface_name" type="s" direction="in"/>
      <arg name="properties" type="a{sv}" direction="out"/>
    </method>
    <signal name="PropertiesChanged">
      <arg name="interface_name" type="s"/>
      <arg name="changed_properties" type="a{sv}"/>
      <arg name="invalidated_properties" type="as"/>
    </signal>
  </interface>
</node>
"""


if DBUS_AVAILABLE:
    class UnknownProperty(dbus.exceptions.DBusException):
        _dbus_error_name = "org.freedesktop.DBus.Error.UnknownProperty"

    class UnknownInterface(dbus.exceptions.DBusException):
        _dbus_error_name = "org.freedesktop.DBus.Error.UnknownInterface"

    class NotSupported(dbus.exceptions.DBusException):
        _dbus_error_name = "org.freedesktop.DBus.Error.NotSupported"

        def __init__(self, message="MoeKoe Music 未开放该控制能力"):
            super().__init__(message)

    class MprisObject(dbus.service.Object):
        def __init__(self, bus, state):
            super().__init__(bus, OBJECT_PATH)
            self.state = state

        # ---------------- 属性表 ----------------
        def properties_of(self, interface):
            if interface == IFACE_ROOT:
                return root_properties()
            if interface == IFACE_PLAYER:
                return player_properties(self.state)
            return None

        def lookup(self, interface, prop):
            table = self.properties_of(interface)
            if table is None:
                raise UnknownInterface("未知接口: %s" % interface)
            if prop not in table:
                raise UnknownProperty("未知属性: %s.%s" % (interface, prop))
            return table[prop]

        # ---------------- org.freedesktop.DBus.Properties ----------------
        @dbus.service.method(IFACE_PROPS, in_signature="ss", out_signature="v")
        def Get(self, interface, prop):
            signature, value = self.lookup(interface, prop)
            return typed(signature, value)

        @dbus.service.method(IFACE_PROPS, in_signature="ssv", out_signature="")
        def Set(self, interface, prop, value):
            self.lookup(interface, prop)
            raise NotSupported("只读属性，不支持修改: %s.%s" % (interface, prop))

        @dbus.service.method(IFACE_PROPS, in_signature="s", out_signature="a{sv}")
        def GetAll(self, interface):
            table = self.properties_of(interface)
            if table is None:
                raise UnknownInterface("未知接口: %s" % interface)
            out = dbus.Dictionary(signature="sv")
            for name, (signature, value) in table.items():
                out[name] = typed(signature, value)
            return out

        @dbus.service.signal(IFACE_PROPS, signature="sa{sv}as")
        def PropertiesChanged(self, interface, changed, invalidated):
            """org.freedesktop.DBus.Properties.PropertiesChanged"""

        def notify(self, interface, names):
            table = self.properties_of(interface)
            if table is None:
                return
            changed = dbus.Dictionary(signature="sv")
            for name in names:
                if name in table:
                    signature, value = table[name]
                    changed[name] = typed(signature, value)
            if changed:
                self.PropertiesChanged(interface, changed, dbus.Array([], signature="s"))

        # ---------------- MPRIS 根接口 ----------------
        @dbus.service.method(IFACE_ROOT, in_signature="", out_signature="")
        def Raise(self):
            raise NotSupported("MoeKoe Music 未开放 Raise")

        @dbus.service.method(IFACE_ROOT, in_signature="", out_signature="")
        def Quit(self):
            raise NotSupported("MoeKoe Music 未开放 Quit")

        # ---------------- MPRIS Player：通过桥接页控制 MoeKoe ----------------
        @dbus.service.method(IFACE_PLAYER, in_signature="", out_signature="")
        def Next(self):
            emit({"type": "control", "command": "next"})

        @dbus.service.method(IFACE_PLAYER, in_signature="", out_signature="")
        def Previous(self):
            emit({"type": "control", "command": "prev"})

        @dbus.service.method(IFACE_PLAYER, in_signature="", out_signature="")
        def Pause(self):
            if self.state.status == "Playing":
                emit({"type": "control", "command": "toggle"})

        @dbus.service.method(IFACE_PLAYER, in_signature="", out_signature="")
        def PlayPause(self):
            emit({"type": "control", "command": "toggle"})

        @dbus.service.method(IFACE_PLAYER, in_signature="", out_signature="")
        def Stop(self):
            if self.state.status == "Playing":
                emit({"type": "control", "command": "toggle"})

        @dbus.service.method(IFACE_PLAYER, in_signature="", out_signature="")
        def Play(self):
            if self.state.status != "Playing":
                emit({"type": "control", "command": "toggle"})

        @dbus.service.method(IFACE_PLAYER, in_signature="x", out_signature="")
        def Seek(self, offset):
            raise NotSupported("MoeKoe WebSocket API 未开放 Seek")

        @dbus.service.method(IFACE_PLAYER, in_signature="ox", out_signature="")
        def SetPosition(self, track_id, position):
            raise NotSupported("MoeKoe WebSocket API 未开放 SetPosition")

        @dbus.service.method(IFACE_PLAYER, in_signature="s", out_signature="")
        def OpenUri(self, uri):
            raise NotSupported("MoeKoe WebSocket API 未开放 OpenUri")

        # ---------------- Introspection ----------------
        @dbus.service.method(
            "org.freedesktop.DBus.Introspectable", in_signature="", out_signature="s"
        )
        def Introspect(self):
            return INTROSPECT_XML


# --------------------------------------------------------------------------
# 入站消息处理
# --------------------------------------------------------------------------

class Controller:
    def __init__(self, state, obj):
        self.state = state
        self.obj = obj

    def handle(self, payload):
        handler = {
            "hello": self.on_hello,
            "track": self.on_track,
            "status": self.on_status,
            "position": self.on_position,
            "status-request": self.on_status_request,
            "bridge-command": self.on_bridge_command,
            "ping": self.on_ping,
        }.get(payload.get("type"))

        if handler is None:
            emit({"type": "error", "message": "未知消息类型: %s" % payload.get("type")})
            return False
        try:
            handler(payload)
        except Exception as exc:  # noqa: BLE001 - 单条消息不能拖垮整个进程
            log("处理消息失败: %r" % exc)
            emit({"type": "error", "message": "处理消息失败: %s" % exc})
        return False

    # ---- 握手 ----
    def on_hello(self, payload):
        emit(
            {
                "type": "ready",
                "protocol": PROTOCOL,
                "dbusName": DBUS_NAME,
                "objectPath": OBJECT_PATH,
                "pid": os.getpid(),
                "dbus": "dbus-python",
            }
        )

    # ---- 曲目 ----
    def on_track(self, payload):
        track = payload.get("track") or {}
        if not isinstance(track, dict):
            track = {}
        track_key = str(track.get("id") or track.get("title") or "")
        track_changed = track_key != self.state.track_key

        self.state.track = track
        self.state.track_key = track_key
        self.state.track_id = make_track_id(track) if track_key else (
            OBJECT_PATH + "/Track/none"
        )

        try:
            self.state.duration_us = max(int(float(payload.get("duration") or 0) * 1_000_000), 0)
        except (TypeError, ValueError):
            self.state.duration_us = 0

        if track_changed:
            if payload.get("position") is not None:
                self.state.set_position_seconds(payload.get("position"))
            else:
                self.state.set_position_seconds(0)
        elif payload.get("position") is not None:
            self.state.set_position_seconds(payload.get("position"))

        status = payload.get("status")
        if status in ("Playing", "Paused"):
            self.state.set_status(status)

        if track_changed:
            self.obj.notify(IFACE_PLAYER, ["PlaybackStatus", "Metadata"])
        else:
            self.obj.notify(IFACE_PLAYER, ["Metadata"])

    # ---- 播放状态与进度 ----
    def on_status(self, payload):
        status = "Playing" if payload.get("isPlaying") else "Paused"
        position = payload.get("position")
        changed = self.state.set_status(status, position)
        if changed:
            self.obj.notify(IFACE_PLAYER, ["PlaybackStatus"])
        snapshot = payload.get("snapshot")
        if isinstance(snapshot, dict):
            self.state.bridge_status = snapshot
            self.state.bridge_status_at = time.time()

    def on_position(self, payload):
        self.state.set_position_seconds(payload.get("position"))

    # ---- 状态回执 / 指令中继 ----
    def on_status_request(self, payload):
        emit({"type": "status", "status": self.status_payload()})

    def on_bridge_command(self, payload):
        cmd = str(payload.get("cmd") or "")
        if cmd not in ("reconnect", "push-all"):
            emit({"type": "error", "message": "未知 bridge-command: %s" % cmd})
            return
        emit({"type": "bridge-command", "cmd": cmd})

    def status_payload(self):
        merged = dict(self.state.bridge_status)
        merged.update(
            {
                "hostReady": True,
                "bridgeAlive": bool(
                    self.state.bridge_status
                    and time.time() - self.state.bridge_status_at < 5.0
                ),
                "pid": os.getpid(),
                "statusAt": int(time.time() * 1000),
            }
        )
        return merged

    def on_ping(self, payload):
        emit({"type": "pong", "time": int(time.time() * 1000)})


# --------------------------------------------------------------------------
# stdin / 生命周期
# --------------------------------------------------------------------------

def request_quit():
    _quit_flag["value"] = True
    loop = _main_loop["obj"]
    if loop is not None:
        loop.quit()
    return False


def schedule(callback, *args):
    if DBUS_AVAILABLE:
        GLib.idle_add(callback, *args)
    else:
        callback(*args)


def read_stdin(controller):
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            message = json.loads(line)
        except Exception:  # noqa: BLE001
            emit({"type": "error", "message": "stdin 收到非法 JSON"})
            continue

        kind = message.get("type")
        if kind == "shutdown":
            log("收到 shutdown，准备退出")
            schedule(request_quit)
            break
        if kind == "message":
            payload = message.get("payload")
            if isinstance(payload, dict):
                schedule(controller.handle, payload)
            else:
                emit({"type": "error", "message": "payload 必须是对象"})
            continue
        emit({"type": "error", "message": "未知消息类型: %s" % kind})

    if not _quit_flag["value"]:
        log("stdin 已关闭，准备退出")
        schedule(request_quit)


def degraded_loop():
    """缺少 D-Bus 依赖时只读 stdin，保证协议不悬空。"""
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            message = json.loads(line)
        except Exception:  # noqa: BLE001
            continue
        if message.get("type") == "shutdown":
            break


def main():
    if not DBUS_AVAILABLE:
        emit(
            {
                "type": "error",
                "code": "missing-dbus",
                "message": (
                    "缺少 D-Bus Python 绑定: %s。"
                    "请安装：Debian/Ubuntu `sudo apt install python3-dbus python3-gi`，"
                    "Fedora `sudo dnf install python3-dbus python3-gobject`"
                    % DBUS_IMPORT_ERROR
                ),
            }
        )
        degraded_loop()
        emit({"type": "bye"})
        return 1

    DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    reply = bus.request_name(
        DBUS_NAME,
        dbus.bus.NAME_FLAG_REPLACE_EXISTING | dbus.bus.NAME_FLAG_DO_NOT_QUEUE,
    )
    if reply != dbus.bus.REQUEST_NAME_REPLY_PRIMARY_OWNER:
        emit(
            {
                "type": "error",
                "code": "name-taken",
                "message": "无法获取 D-Bus 名称 %s（reply=%s）" % (DBUS_NAME, reply),
            }
        )
        degraded_loop()
        emit({"type": "bye"})
        return 1

    state = PlayerState()
    obj = MprisObject(bus, state)
    controller = Controller(state, obj)

    loop = GLib.MainLoop()
    _main_loop["obj"] = loop

    for signame in ("SIGTERM", "SIGINT"):
        try:
            import signal as signal_module

            signal_module.signal(
                getattr(signal_module, signame),
                lambda *_args: schedule(request_quit),
            )
        except Exception:  # noqa: BLE001
            pass

    emit(
        {
            "type": "ready",
            "protocol": PROTOCOL,
            "dbusName": DBUS_NAME,
            "objectPath": OBJECT_PATH,
            "pid": os.getpid(),
            "dbus": "dbus-python",
        }
    )
    log("已注册 %s" % DBUS_NAME)

    threading.Thread(target=read_stdin, args=(controller,), daemon=True).start()
    try:
        loop.run()
    finally:
        try:
            bus.release_name(DBUS_NAME)
        except Exception:  # noqa: BLE001
            pass
        emit({"type": "bye"})
        log("已退出")
    return 0


if __name__ == "__main__":
    sys.exit(main())
