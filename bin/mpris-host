    </method>
    <method name="GetAll">
      <arg name="interface_name" type="s" direction="in"/>
      <arg name="properties" type="a{sv}" direction="out"/>
    </method>
    <signal name="PropertiesChanged">
      <arg name="interface_name" type="s"/>
      <arg name="changed_properties" type="a{sv}"/>
      <arg name="invalidated_properties" type="as"/>
    </signal>
  </interface>
</node>
"""


if DBUS_AVAILABLE:
    class UnknownProperty(dbus.exceptions.DBusException):
        _dbus_error_name = "org.freedesktop.DBus.Error.UnknownProperty"

    class UnknownInterface(dbus.exceptions.DBusException):
        _dbus_error_name = "org.freedesktop.DBus.Error.UnknownInterface"

    class NotSupported(dbus.exceptions.DBusException):
        _dbus_error_name = "org.freedesktop.DBus.Error.NotSupported"

        def __init__(self, message="MoeKoe Music 未开放该控制能力"):
            super().__init__(message)

    class MprisObject(dbus.service.Object):
        def __init__(self, bus, state):
            super().__init__(bus, OBJECT_PATH)
            self.state = state

        # ---------------- 属性表 ----------------
        def properties_of(self, interface):
            if interface == IFACE_ROOT:
                return root_properties()
            if interface == IFACE_PLAYER:
                return player_properties(self.state)
            if interface == IFACE_LYRICS:
                return lyrics_properties(self.state)
            if interface == IFACE_OVERLAY:
                return overlay_properties(self.state)
            return None

        def lookup(self, interface, prop):
            table = self.properties_of(interface)
            if table is None:
                raise UnknownInterface("未知接口: %s" % interface)
            if prop not in table:
                raise UnknownProperty("未知属性: %s.%s" % (interface, prop))
            return table[prop]

        # ---------------- org.freedesktop.DBus.Properties ----------------
        @dbus.service.method(IFACE_PROPS, in_signature="ss", out_signature="v")
        def Get(self, interface, prop):
            signature, value = self.lookup(interface, prop)
            return typed(signature, value)

        @dbus.service.method(IFACE_PROPS, in_signature="ssv", out_signature="")
        def Set(self, interface, prop, value):
            self.lookup(interface, prop)
            raise NotSupported("只读属性，不支持修改: %s.%s" % (interface, prop))

        @dbus.service.method(IFACE_PROPS, in_signature="s", out_signature="a{sv}")
        def GetAll(self, interface):
            table = self.properties_of(interface)
            if table is None:
                raise UnknownInterface("未知接口: %s" % interface)
            out = dbus.Dictionary(signature="sv")
            for name, (signature, value) in table.items():
                out[name] = typed(signature, value)
            return out

        @dbus.service.signal(IFACE_PROPS, signature="sa{sv}as")
        def PropertiesChanged(self, interface, changed, invalidated):
            """org.freedesktop.DBus.Properties.PropertiesChanged"""

        def notify(self, interface, names):
            table = self.properties_of(interface)
            if table is None:
                return
            changed = dbus.Dictionary(signature="sv")
            for name in names:
                if name in table:
                    signature, value = table[name]
                    changed[name] = typed(signature, value)
            if changed:
                self.PropertiesChanged(interface, changed, dbus.Array([], signature="s"))

        # ---------------- 歌词扩展 ----------------
        @dbus.service.signal(IFACE_LYRICS, signature="a{sv}")
        def LineChanged(self, line):
            """org.moekoe.MPRIS.Lyrics.LineChanged"""

        def emit_line_signal(self):
            # 与 CurrentLine 属性走同一构造函数，负载逐字段一致
            self.LineChanged(to_variant_dict(self.state.line_payload()))

        def emit_line(self):
            self.emit_line_signal()
            self.notify(IFACE_LYRICS, ["CurrentLine"])
            self.notify(IFACE_PLAYER, ["Metadata"])

        # ---------------- 悬浮窗扩展：拖动后回写自由位置 ----------------
        @dbus.service.method(IFACE_OVERLAY, in_signature="ii", out_signature="")
        def SavePosition(self, x, y):
            """悬浮客户端拖动结束后把自由坐标回写宿主，由宿主持久化。

            位置模型：Position 为预设值或 "custom"；"custom" 时用 PosX/PosY
            表示相对当前输出左上角的像素坐标。
            """
            self.state.overlay_position = CUSTOM_POSITION
            self.state.overlay_x = int(x)
            self.state.overlay_y = int(y)
            save_config(self.state)
            self.notify(IFACE_OVERLAY, ["Position", "PosX", "PosY"])

        # ---------------- MPRIS 根接口 ----------------
        @dbus.service.method(IFACE_ROOT, in_signature="", out_signature="")
        def Raise(self):
            raise NotSupported("MoeKoe Music 插件未开放 Raise")

        @dbus.service.method(IFACE_ROOT, in_signature="", out_signature="")
        def Quit(self):
            raise NotSupported("MoeKoe Music 插件未开放 Quit")

        # ---------------- MPRIS Player（最小可用：不开放控制） ----------------
        @dbus.service.method(IFACE_PLAYER, in_signature="", out_signature="")
        def Next(self):
            raise NotSupported()

        @dbus.service.method(IFACE_PLAYER, in_signature="", out_signature="")
        def Previous(self):
            raise NotSupported()

        @dbus.service.method(IFACE_PLAYER, in_signature="", out_signature="")
        def Pause(self):
            raise NotSupported()

        @dbus.service.method(IFACE_PLAYER, in_signature="", out_signature="")
        def PlayPause(self):
            raise NotSupported()

        @dbus.service.method(IFACE_PLAYER, in_signature="", out_signature="")
        def Stop(self):
            raise NotSupported()

        @dbus.service.method(IFACE_PLAYER, in_signature="", out_signature="")
        def Play(self):
            raise NotSupported()

        @dbus.service.method(IFACE_PLAYER, in_signature="x", out_signature="")
        def Seek(self, offset):
            raise NotSupported()

        @dbus.service.method(IFACE_PLAYER, in_signature="ox", out_signature="")
        def SetPosition(self, track_id, position):
            raise NotSupported()

        @dbus.service.method(IFACE_PLAYER, in_signature="s", out_signature="")
        def OpenUri(self, uri):
            raise NotSupported()

        # ---------------- Introspection ----------------
        @dbus.service.method(
            "org.freedesktop.DBus.Introspectable", in_signature="", out_signature="s"
        )
        def Introspect(self):
            return INTROSPECT_XML


# --------------------------------------------------------------------------
# 入站消息处理
# --------------------------------------------------------------------------

class Controller:
    def __init__(self, state, obj):
        self.state = state
        self.obj = obj

    def handle(self, payload):
        handler = {
            "hello": self.on_hello,
            "mode": self.on_mode,
            "track": self.on_track,
            "lyrics": self.on_lyrics,
            "line": self.on_line,
            "status": self.on_status,
            "position": self.on_position,
            "config": self.on_config,
            "status-request": self.on_status_request,
            "bridge-command": self.on_bridge_command,
            "overlay-restart": self.on_overlay_restart,
            "ping": self.on_ping,
        }.get(payload.get("type"))

        if handler is None:
            emit({"type": "error", "message": "未知消息类型: %s" % payload.get("type")})
            return False
        try:
            handler(payload)
        except Exception as exc:  # noqa: BLE001 - 单条消息不能拖垮整个进程
            log("处理消息失败: %r" % exc)
            emit({"type": "error", "message": "处理消息失败: %s" % exc})
        return False

    # ---- 握手 / 模式 ----
    def on_hello(self, payload):
        # 只有显式携带 mode 的 hello 才覆盖（兼容旧桥接页）；重启后的默认值
        # 来自持久化配置，桥接页重连不会把弹窗里设置的模式冲掉。
        if payload.get("mode") is not None:
            mode = normalize_mode(payload.get("mode"))
            if mode != self.state.mode:
                self.state.mode = mode
                self.state.refresh_lyrics_json()
                self.obj.notify(IFACE_LYRICS, ["Mode", "LyricsJson"])
                self.obj.emit_line()
        emit(
            {
                "type": "ready",
                "protocol": PROTOCOL,
                "dbusName": DBUS_NAME,
                "objectPath": OBJECT_PATH,
                "mode": self.state.mode,
                "pid": os.getpid(),
                "dbus": "dbus-python",
            }
        )

    def on_mode(self, payload):
        mode = normalize_mode(payload.get("mode"))
        if mode == self.state.mode:
            return
        self.state.mode = mode
        self.state.refresh_lyrics_json()
        save_config(self.state)
        self.obj.notify(IFACE_LYRICS, ["Mode", "LyricsJson"])
        self.obj.emit_line()  # LineChanged + CurrentLine + Metadata 一次发布

    # ---- 曲目 ----
    def on_track(self, payload):
        track = payload.get("track") or {}
        if not isinstance(track, dict):
            track = {}
        track_key = str(track.get("id") or track.get("title") or "")
        track_changed = track_key != self.state.track_key

        self.state.track = track
        self.state.track_key = track_key
        self.state.track_id = make_track_id(track) if track_key else (
            OBJECT_PATH + "/Track/none"
        )

        try:
            self.state.duration_us = max(int(float(payload.get("duration") or 0) * 1_000_000), 0)
        except (TypeError, ValueError):
            self.state.duration_us = 0

        if track_changed:
            self.state.clear_lyrics()
            if payload.get("position") is not None:
                self.state.set_position_seconds(payload.get("position"))
            else:
                self.state.set_position_seconds(0)
        elif payload.get("position") is not None:
            self.state.set_position_seconds(payload.get("position"))

        status = payload.get("status")
        if status in ("Playing", "Paused"):
            self.state.set_status(status)

        if track_changed:
            self.obj.notify(IFACE_PLAYER, ["PlaybackStatus"])
            self.obj.notify(IFACE_LYRICS, ["LyricsJson"])
            self.obj.emit_line()  # LineChanged + CurrentLine + Metadata 一次发布
        else:
            names = ["Metadata"]
            self.obj.notify(IFACE_PLAYER, names)

    # ---- 歌词 ----
    def on_lyrics(self, payload):
        lines = payload.get("lines")
        self.state.lines = lines if isinstance(lines, list) else []
        self.state.refresh_lyrics_json()
        self.obj.notify(IFACE_LYRICS, ["LyricsJson"])

    def on_line(self, payload):
        line = payload.get("line")
        self.state.raw_line = line if isinstance(line, dict) else None
        self.obj.emit_line()

    # ---- 播放状态与进度 ----
    def on_status(self, payload):
        status = "Playing" if payload.get("isPlaying") else "Paused"
        position = payload.get("position")
        changed = self.state.set_status(status, position)
        if changed:
            self.obj.notify(IFACE_PLAYER, ["PlaybackStatus"])
        snapshot = payload.get("snapshot")
        if isinstance(snapshot, dict):
            # 桥接页全量快照：弹窗设置页与状态列表都以它为准
            self.state.bridge_status = snapshot
            self.state.bridge_status_at = time.time()

    def on_position(self, payload):
        self.state.set_position_seconds(payload.get("position"))

    # ---- 弹窗：显示配置 / 状态回执 / 指令中继 ----
    def on_config(self, payload):
        changed = []
        if isinstance(payload.get("enabled"), bool) and payload["enabled"] != self.state.overlay_enabled:
            self.state.overlay_enabled = payload["enabled"]
            changed.append("Enabled")
        if payload.get("opacity") is not None:
            try:
                value = min(max(float(payload.get("opacity")), 0.0), 1.0)
            except (TypeError, ValueError):
                value = None
            if value is not None and abs(value - self.state.overlay_opacity) > 1e-9:
                self.state.overlay_opacity = value
                changed.append("Opacity")
        if payload.get("position") in POSITIONS and payload["position"] != self.state.overlay_position:
            self.state.overlay_position = payload["position"]
            changed.append("Position")
        if isinstance(payload.get("clickThrough"), bool) and payload["clickThrough"] != self.state.overlay_click_through:
            self.state.overlay_click_through = payload["clickThrough"]
            changed.append("ClickThrough")
        if payload.get("scale") is not None:
            try:
                value = min(max(float(payload.get("scale")), SCALE_MIN), SCALE_MAX)
            except (TypeError, ValueError):
                value = None
            if value is not None and abs(value - self.state.overlay_scale) > 1e-9:
                self.state.overlay_scale = value
                changed.append("Scale")
        if not changed:
            return
        save_config(self.state)
        self.obj.notify(IFACE_OVERLAY, changed)
        ensure_overlay(self.state)  # 开关从关到开且进程不在时补拉起

    def on_status_request(self, payload):
        emit({"type": "status", "status": self.status_payload()})

    def on_overlay_restart(self, payload):
        """弹窗「立即重启悬浮歌词」：结束当前客户端并拉起新进程。

        与「完全重启 MoeKoe」等价，但不用重启整个应用；重启后回执一次
        合并状态，弹窗据此刷新运行指示。
        """
        restart_overlay(self.state)
        emit({"type": "status", "status": self.status_payload()})

    def on_bridge_command(self, payload):
        cmd = str(payload.get("cmd") or "")
        if cmd not in ("reconnect", "push-all"):
            emit({"type": "error", "message": "未知 bridge-command: %s" % cmd})
            return
        # 再广播回 stdout：桥接页执行指令，弹窗顺带收到用于刷新
        emit({"type": "bridge-command", "cmd": cmd})

    def status_payload(self):
        """宿主侧合并状态：桥接页快照 + 宿主真相（弹窗设置页的唯一数据源）。"""
        merged = dict(self.state.bridge_status)
        proc = _overlay_proc["proc"]
        merged.update(
            {
                "hostReady": True,
                "mode": self.state.mode,
                "overlay": {
                    "enabled": bool(self.state.overlay_enabled),
                    "opacity": round(float(self.state.overlay_opacity), 4),
                    "position": self.state.overlay_position,
                    "clickThrough": bool(self.state.overlay_click_through),
                    "scale": round(float(self.state.overlay_scale), 4),
                    "x": int(self.state.overlay_x),
                    "y": int(self.state.overlay_y),
                    "running": bool(proc is not None and proc.poll() is None),
                },
                "bridgeAlive": bool(
                    self.state.bridge_status
                    and time.time() - self.state.bridge_status_at < 5.0
                ),
                "pid": os.getpid(),
                "statusAt": int(time.time() * 1000),
            }
        )
        return merged

    def on_ping(self, payload):
        emit({"type": "pong", "time": int(time.time() * 1000)})


# --------------------------------------------------------------------------
# stdin / 生命周期
# --------------------------------------------------------------------------

def request_quit():
    _quit_flag["value"] = True
    loop = _main_loop["obj"]
    if loop is not None:
        loop.quit()
    return False


def schedule(callback, *args):
    if DBUS_AVAILABLE:
        GLib.idle_add(callback, *args)
    else:
        callback(*args)


def read_stdin(controller):
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            message = json.loads(line)
        except Exception:  # noqa: BLE001
            emit({"type": "error", "message": "stdin 收到非法 JSON"})
            continue

        kind = message.get("type")
        if kind == "shutdown":
            log("收到 shutdown，准备退出")
            schedule(request_quit)
            break
        if kind == "message":
            payload = message.get("payload")
            if isinstance(payload, dict):
                schedule(controller.handle, payload)
            else:
                emit({"type": "error", "message": "payload 必须是对象"})
            continue
        emit({"type": "error", "message": "未知消息类型: %s" % kind})

    if not _quit_flag["value"]:
        log("stdin 已关闭，准备退出")
        schedule(request_quit)


def degraded_loop():
    """缺少 D-Bus 依赖时只读 stdin，保证协议不悬空。"""
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            message = json.loads(line)
        except Exception:  # noqa: BLE001
            continue
        if message.get("type") == "shutdown":
            break


OVERLAY_SCRIPT = os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
    "extras", "moekoe-lyric-overlay", "moekoe-lyric-overlay",
)

_overlay_proc = {"proc": None}


def spawn_overlay(state):
    """随宿主启动悬浮歌词客户端（MoeKoe 起 → 宿主起 → 这里拉起）。

    MOEKOE_MPRIS_NO_OVERLAY=1 时跳过（自动化测试用）；显示开关关闭时不拉起；
    子进程输出写入 ~/.cache/moekoe-mpris/overlay.log，便于排查未启动的原因。
    """
    if os.environ.get("MOEKOE_MPRIS_NO_OVERLAY") == "1":
        return None
    if not state.overlay_enabled:
        log("悬浮歌词显示开关为关，跳过启动")
        return None
    if not os.path.isfile(OVERLAY_SCRIPT):
        log("悬浮歌词客户端不存在，跳过自动启动: %s" % OVERLAY_SCRIPT)
        return None

    log_file = None
    try:
        log_dir = os.path.join(
            os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
            "moekoe-mpris",
        )
        os.makedirs(log_dir, exist_ok=True)
        log_file = open(os.path.join(log_dir, "overlay.log"), "ab", buffering=0)
    except OSError:
        pass

    try:
        # 经 python3 启动：zip 解压后脚本可能没有可执行位
        proc = subprocess.Popen(
            [sys.executable, OVERLAY_SCRIPT],
            stdin=subprocess.DEVNULL,
            stdout=log_file or subprocess.DEVNULL,
            stderr=log_file or subprocess.DEVNULL,
        )
    except Exception as exc:  # noqa: BLE001
        log("拉起悬浮歌词客户端失败: %s" % exc)
        return None
    finally:
        if log_file is not None:
            log_file.close()

    log("已拉起悬浮歌词客户端（pid=%d）" % proc.pid)
    return proc


def ensure_overlay(state):
    """开关打开但没有存活进程时补拉一次（弹窗打开开关触发）。"""
    proc = _overlay_proc["proc"]
    if proc is not None and proc.poll() is None:
        return proc
    _overlay_proc["proc"] = spawn_overlay(state)
    return _overlay_proc["proc"]


def restart_overlay(state):
    """结束当前悬浮客户端再拉起一个新的（弹窗「立即重启」触发）。

    先 SIGTERM 等其自行退出（释放 org.moekoe.LyricOverlay 单实例名），
    超时才 SIGKILL；随后交给 ensure_overlay 按当前开关决定是否拉起。
    """
    proc = _overlay_proc["proc"]
    if proc is not None and proc.poll() is None:
        try:
            proc.terminate()
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            try:
                proc.kill()
                proc.wait(timeout=1)
            except Exception:  # noqa: BLE001 - 退出兜底，失败也不阻塞重启
                pass
        except Exception:  # noqa: BLE001
            pass
    _overlay_proc["proc"] = None
    return ensure_overlay(state)



def main():
    if not DBUS_AVAILABLE:
        emit(
            {
                "type": "error",
                "code": "missing-dbus",
                "message": (
                    "缺少 D-Bus Python 绑定: %s。"
                    "请安装：Debian/Ubuntu `sudo apt install python3-dbus python3-gi`，"
                    "Fedora `sudo dnf install python3-dbus python3-gobject`"
                    % DBUS_IMPORT_ERROR
                ),
            }
        )
        degraded_loop()
        emit({"type": "bye"})
        return 1

    DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    reply = bus.request_name(
        DBUS_NAME,
        dbus.bus.NAME_FLAG_REPLACE_EXISTING | dbus.bus.NAME_FLAG_DO_NOT_QUEUE,
    )
    if reply != dbus.bus.REQUEST_NAME_REPLY_PRIMARY_OWNER:
        emit(
            {
                "type": "error",
                "code": "name-taken",
                "message": "无法获取 D-Bus 名称 %s（reply=%s）" % (DBUS_NAME, reply),
            }
        )
        degraded_loop()
        emit({"type": "bye"})
        return 1

    state = PlayerState()
    obj = MprisObject(bus, state)
    controller = Controller(state, obj)

    loop = GLib.MainLoop()
    _main_loop["obj"] = loop

    for signame in ("SIGTERM", "SIGINT"):
        try:
            import signal as signal_module

            signal_module.signal(
                getattr(signal_module, signame),
                lambda *_args: schedule(request_quit),
            )
        except Exception:  # noqa: BLE001
            pass

    emit(
        {
            "type": "ready",
            "protocol": PROTOCOL,
            "dbusName": DBUS_NAME,
            "objectPath": OBJECT_PATH,
            "mode": state.mode,
            "pid": os.getpid(),
            "dbus": "dbus-python",
        }
    )
    log("已注册 %s（mode=%s）" % (DBUS_NAME, state.mode))
    overlay_proc = spawn_overlay(state)
    _overlay_proc["proc"] = overlay_proc

    threading.Thread(target=read_stdin, args=(controller,), daemon=True).start()
    try:
        loop.run()
    finally:
        if overlay_proc is not None:
            try:
                if overlay_proc.poll() is None:
                    overlay_proc.terminate()
            except Exception:  # noqa: BLE001
                pass
        try:
            bus.release_name(DBUS_NAME)
        except Exception:  # noqa: BLE001
            pass
        emit({"type": "bye"})
        log("已退出")
    return 0


if __name__ == "__main__":
    sys.exit(main())
