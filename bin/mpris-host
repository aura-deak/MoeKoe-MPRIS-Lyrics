#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""MoeKoe Music MPRIS 本地程序（native host）

由 MoeKoe Music 插件系统托管，通过 stdin/stdout 的 JSON Lines 协议通信：

  入站（MoeKoe -> 本程序）
    {"type":"message","payload":{...}}
    {"type":"shutdown"}

  出站（本程序 -> MoeKoe，转发给插件桥接页）
    {"type":"ready",...} / {"type":"error",...} / {"type":"pong",...} / {"type":"bye"}

payload 类型：
    hello    桥接页握手，携带当前传输模式
    mode     切换歌词传输模式 original | translation | both
    track    曲目元数据（标题/歌手/专辑/封面/时长/进度/播放状态）
    lyrics   整首歌词（原始行，未按模式投影）
    line     当前行歌词
    status   播放状态与进度
    position 仅进度校正
    ping     心跳

本程序在会话 D-Bus 上注册 org.mpris.MediaPlayer2.MoeKoeMusic，实现：
    org.mpris.MediaPlayer2            根接口（最小可用，不开放控制）
    org.mpris.MediaPlayer2.Player     播放状态、Metadata、Position
    org.moekoe.MPRIS.Lyrics           歌词扩展：Mode / CurrentLine / LyricsJson + LineChanged 信号

歌词只通过 Metadata 自定义键（moekoe:lyrics / moekoe:translation）和
LineChanged 信号对外传输，具体传什么由当前传输模式决定：
    original   单歌词    只传原文
    translation单翻译    只传翻译
    both       歌词翻译  原文 + 翻译

日志一律写 stderr，stdout 只输出 JSON Lines。
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import threading
import time

PROTOCOL = 1
DBUS_NAME = "org.mpris.MediaPlayer2.MoeKoeMusic"
OBJECT_PATH = "/org/mpris/MediaPlayer2"

IFACE_ROOT = "org.mpris.MediaPlayer2"
IFACE_PLAYER = "org.mpris.MediaPlayer2.Player"
IFACE_LYRICS = "org.moekoe.MPRIS.Lyrics"
IFACE_OVERLAY = "org.moekoe.MPRIS.Overlay"
IFACE_PROPS = "org.freedesktop.DBus.Properties"

MODES = ("original", "translation", "both")
DEFAULT_MODE = "both"
POSITIONS = (
    "top-left", "top-center", "top-right",
    "bottom-left", "bottom-center", "bottom-right",
)
CUSTOM_POSITION = "custom"   # 拖动后的自由位置，坐标见 PosX/PosY
DEFAULT_POSITION = "bottom-center"
DEFAULT_OPACITY = 0.62
DEFAULT_SCALE = 1.0
SCALE_MIN = 0.5
SCALE_MAX = 2.0
CONFIG_ENV_DIR = "MOEKOE_MPRIS_CONFIG_DIR"

_stdout_lock = threading.Lock()
_quit_flag = {"value": False}
_main_loop = {"obj": None}

try:  # pragma: no cover - 依赖缺失时降级运行
    import dbus
    import dbus.exceptions
    import dbus.service
    from dbus.mainloop.glib import DBusGMainLoop
    from gi.repository import GLib

    DBUS_AVAILABLE = True
    DBUS_IMPORT_ERROR = ""
except Exception as exc:  # noqa: BLE001 - 需要把具体缺失原因告诉用户
    DBUS_AVAILABLE = False
    DBUS_IMPORT_ERROR = str(exc)


# --------------------------------------------------------------------------
# 标准输出 / 日志
# --------------------------------------------------------------------------

def emit(payload):
    """向 stdout 写一行 JSON（MoeKoe 会转发给插件桥接页）。"""
    line = json.dumps(payload, ensure_ascii=False)
    with _stdout_lock:
        try:
            sys.stdout.write(line + "\n")
            sys.stdout.flush()
        except Exception:  # noqa: BLE001 - 管道已关闭时直接放弃
            pass


def log(message):
    try:
        sys.stderr.write("[mpris-host] %s\n" % message)
        sys.stderr.flush()
    except Exception:  # noqa: BLE001
        pass


# --------------------------------------------------------------------------
# 歌词投影
# --------------------------------------------------------------------------

def normalize_mode(mode):
    return mode if mode in MODES else DEFAULT_MODE


def project_line(line, mode):
    """把原始歌词行投影成当前传输模式下要上总线的字段。"""
    mode = normalize_mode(mode)
    out = {
        "index": int(line.get("index", -1)),
        "start": int(line.get("start", 0) or 0),
        "duration": int(line.get("duration", 0) or 0),
    }
    if mode in ("original", "both"):
        out["text"] = str(line.get("text") or "")
    if mode in ("translation", "both"):
        out["translation"] = str(line.get("translation") or "")
    return out


def project_lines(lines, mode):
    return [project_line(line, mode) for line in lines or []]


# --------------------------------------------------------------------------
# 配置持久化（弹窗是唯一写入口，宿主是唯一真相源）
# --------------------------------------------------------------------------

def config_dir():
    override = os.environ.get(CONFIG_ENV_DIR)
    if override:
        return override
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "moekoe-mpris")


def config_file():
    return os.path.join(config_dir(), "config.json")


def load_config():
    """启动时读取持久化配置（传输模式 + 悬浮窗显示设置）。"""
    try:
        with open(config_file(), "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        data = {}
    if not isinstance(data, dict):
        data = {}
    cfg = {
        "mode": DEFAULT_MODE,
        "overlay": {
            "enabled": True,
            "opacity": DEFAULT_OPACITY,
            "position": DEFAULT_POSITION,
            "click_through": True,
            "scale": DEFAULT_SCALE,
            "x": 0,
            "y": 0,
        },
    }
    if data.get("mode") in MODES:
        cfg["mode"] = data["mode"]
    overlay = data.get("overlay")
    if isinstance(overlay, dict):
        if isinstance(overlay.get("enabled"), bool):
            cfg["overlay"]["enabled"] = overlay["enabled"]
        try:
            cfg["overlay"]["opacity"] = min(max(float(overlay.get("opacity")), 0.0), 1.0)
        except (TypeError, ValueError):
            pass
        if overlay.get("position") in POSITIONS or overlay.get("position") == CUSTOM_POSITION:
            cfg["overlay"]["position"] = overlay["position"]
        if isinstance(overlay.get("click_through"), bool):
            cfg["overlay"]["click_through"] = overlay["click_through"]
        try:
            cfg["overlay"]["scale"] = min(
                max(float(overlay.get("scale")), SCALE_MIN), SCALE_MAX)
        except (TypeError, ValueError):
            pass
        for axis in ("x", "y"):
            try:
                cfg["overlay"][axis] = int(overlay.get(axis, 0) or 0)
            except (TypeError, ValueError):
                pass
    return cfg


def save_config(state):
    """模式 / 显示配置变更后落盘，MoeKoe 与宿主重启后不回退。"""
    data = {
        "mode": state.mode,
        "overlay": {
            "enabled": bool(state.overlay_enabled),
            "opacity": float(state.overlay_opacity),
            "position": state.overlay_position,
            "click_through": bool(state.overlay_click_through),
            "scale": float(state.overlay_scale),
            "x": int(state.overlay_x),
            "y": int(state.overlay_y),
        },
    }
    try:
        os.makedirs(config_dir(), exist_ok=True)
        tmp_path = config_file() + ".tmp"
        with open(tmp_path, "w", encoding="utf-8") as handle:
            json.dump(data, handle, ensure_ascii=False, indent=2)
        os.replace(tmp_path, config_file())
    except OSError as exc:
        log("写入配置失败: %s" % exc)


# --------------------------------------------------------------------------
# 播放状态
# --------------------------------------------------------------------------

class PlayerState:
    def __init__(self):
        cfg = load_config()
        self.mode = cfg["mode"]
        self.overlay_enabled = cfg["overlay"]["enabled"]
        self.overlay_opacity = cfg["overlay"]["opacity"]
        self.overlay_position = cfg["overlay"]["position"]
        self.overlay_click_through = cfg["overlay"]["click_through"]
        self.overlay_scale = cfg["overlay"]["scale"]
        self.overlay_x = cfg["overlay"]["x"]
        self.overlay_y = cfg["overlay"]["y"]
        self.bridge_status = {}      # 桥接页最近一次全量快照（弹窗实时状态的数据源）
        self.bridge_status_at = 0.0
        self.status = "Stopped"
        self.track = {}
        self.track_key = ""
        self.track_id = OBJECT_PATH + "/Track/none"
        self.duration_us = 0
        self.lines = []
        self.lyrics_json = "[]"
        self.raw_line = None
        self.position_us = 0
        self.anchor = time.monotonic()

    # ---- 进度 ----
    def set_position_seconds(self, seconds):
        try:
            value = float(seconds or 0)
        except (TypeError, ValueError):
            value = 0.0
        self.position_us = max(int(value * 1_000_000), 0)
        self.anchor = time.monotonic()

    def current_position_us(self):
        value = self.position_us
        if self.status == "Playing":
            value += int((time.monotonic() - self.anchor) * 1_000_000)
        if self.duration_us > 0:
            value = min(value, self.duration_us)
        return max(value, 0)

    def set_status(self, status, position=None):
        if status not in ("Playing", "Paused", "Stopped"):
            return
        changed = status != self.status
        if position is not None:
            self.set_position_seconds(position)
        else:
            self.anchor = time.monotonic()
        self.status = status
        return changed

    # ---- 歌词 ----
    def projected_line(self):
        if not self.raw_line:
            return {"index": -1}
        return project_line(self.raw_line, self.mode)

    def line_payload(self):
        """行负载的唯一构造点：CurrentLine / LineChanged / Metadata 三处出口共用。"""
        payload = self.projected_line()
        payload["mode"] = self.mode
        return payload

    def refresh_lyrics_json(self):
        self.lyrics_json = json.dumps(
            project_lines(self.lines, self.mode), ensure_ascii=False
        )

    def clear_lyrics(self):
        self.lines = []
        self.raw_line = None
        self.refresh_lyrics_json()


def make_track_id(track):
    raw = str(track.get("id") or track.get("title") or "unknown")
    safe = re.sub(r"[^A-Za-z0-9_]", "_", raw)[:64]
    if not safe:
        safe = "unknown"
    if safe[0].isdigit():
        safe = "T_" + safe
    return "%s/Track/%s" % (OBJECT_PATH, safe)


# --------------------------------------------------------------------------
# D-Bus 类型转换
# --------------------------------------------------------------------------
#
# dbus-python 没有 dbus.Variant 类型：只要声明了签名（如 a{sv}、v），
# 普通 Python 值 / dbus 类型会在封送时自动包装成 Variant。

def to_variant_dict(data):
    out = dbus.Dictionary(signature="sv")
    for key, value in dict(data or {}).items():
        out[str(key)] = plain_value(value)
    return out


_DBUS_TYPES_CACHE = None


def dbus_types():
    """已在进程内转换好的 D-Bus 类型集合（缺失绑定时不会走到这里）。"""
    global _DBUS_TYPES_CACHE
    if _DBUS_TYPES_CACHE is None:
        _DBUS_TYPES_CACHE = tuple(
            getattr(dbus, name)
            for name in (
                "Boolean", "Int32", "Int64", "Double", "String",
                "ObjectPath", "Dictionary", "Array", "Signature",
            )
            if getattr(dbus, name, None) is not None
        )
    return _DBUS_TYPES_CACHE


def plain_value(value):
    if isinstance(value, dbus_types()):
        return value
    if isinstance(value, bool):
        return dbus.Boolean(value)
    if isinstance(value, int):
        if -2 ** 31 <= value < 2 ** 31:
            return dbus.Int32(value)
        return dbus.Int64(value)
    if isinstance(value, float):
        return dbus.Double(value)
    if isinstance(value, dict):
        return to_variant_dict(value)
    return dbus.String("" if value is None else str(value))


def typed(signature, value):
    """把 Python 值按 D-Bus 签名转换。"""
    if signature == "b":
        return dbus.Boolean(bool(value))
    if signature == "s":
        return dbus.String(str(value))
    if signature == "x":
        return dbus.Int64(int(value))
    if signature == "i":
        return dbus.Int32(int(value))
    if signature == "d":
        return dbus.Double(float(value))
    if signature == "as":
        return dbus.Array([dbus.String(item) for item in value], signature="s")
    if signature == "a{sv}":
        if isinstance(value, dbus.Dictionary):
            return value
        return to_variant_dict(value)
    raise ValueError("不支持的签名: %s" % signature)


# --------------------------------------------------------------------------
# 属性表
# --------------------------------------------------------------------------

def root_properties():
    return {
        "CanQuit": ("b", False),
        "CanRaise": ("b", False),
        "HasTrackList": ("b", False),
        "Identity": ("s", "MoeKoe Music"),
        "SupportedUriSchemes": ("as", []),
        "SupportedMimeTypes": ("as", []),
    }


def player_properties(state):
    return {
        "PlaybackStatus": ("s", state.status),
        "LoopStatus": ("s", "None"),
        "Rate": ("d", 1.0),
        "Shuffle": ("b", False),
        "Metadata": ("a{sv}", build_metadata(state)),
        "Volume": ("d", 1.0),
        "Position": ("x", state.current_position_us()),
        "MinimumRate": ("d", 1.0),
        "MaximumRate": ("d", 1.0),
        "CanGoNext": ("b", False),
        "CanGoPrevious": ("b", False),
        "CanPlay": ("b", False),
        "CanPause": ("b", False),
        "CanSeek": ("b", False),
        "CanControl": ("b", False),
    }


def lyrics_properties(state):
    return {
        "Mode": ("s", state.mode),
        "CurrentLine": ("a{sv}", state.line_payload()),
        "LyricsJson": ("s", state.lyrics_json),
    }


def overlay_properties(state):
    return {
        "Enabled": ("b", bool(state.overlay_enabled)),
        "Opacity": ("d", float(state.overlay_opacity)),
        "Position": ("s", str(state.overlay_position)),
        "ClickThrough": ("b", bool(state.overlay_click_through)),
        "Scale": ("d", float(state.overlay_scale)),
        "PosX": ("i", int(state.overlay_x)),
        "PosY": ("i", int(state.overlay_y)),
    }


def build_metadata(state):
    metadata = dbus.Dictionary(signature="sv")
    if not state.track:
        return metadata

    metadata["mpris:trackid"] = dbus.ObjectPath(state.track_id)
    if state.duration_us > 0:
        metadata["mpris:length"] = dbus.Int64(state.duration_us)

    title = str(state.track.get("title") or "")
    if title:
        metadata["xesam:title"] = dbus.String(title)

    artists = [str(item) for item in (state.track.get("artists") or []) if item]
    if artists:
        metadata["xesam:artist"] = dbus.Array([dbus.String(a) for a in artists], signature="s")

    album = str(state.track.get("album") or "")
    if album:
        metadata["xesam:album"] = dbus.String(album)

    art = str(state.track.get("artUrl") or "")
    if art.startswith(("http://", "https://", "file://")):
        metadata["mpris:artUrl"] = dbus.String(art)

    # 曲目 URL（现有歌词客户端按它做歌曲识别 / 本地同名 LRC 推导）
    url = str(state.track.get("url") or "")
    if url.startswith(("http://", "https://", "file://")):
        metadata["xesam:url"] = dbus.String(url)

    # 歌词字段与 CurrentLine/LineChanged 同源：投影决定出现与否
    line = state.line_payload()
    if line.get("text"):
        metadata["moekoe:lyrics"] = dbus.String(str(line["text"]))
    if line.get("translation"):
        metadata["moekoe:translation"] = dbus.String(str(line["translation"]))
    return metadata


# --------------------------------------------------------------------------
# Introspection
# --------------------------------------------------------------------------

INTROSPECT_XML = """<node>
  <interface name="org.freedesktop.DBus.Introspectable">
    <method name="Introspect">
      <arg type="s" name="xml_data" direction="out"/>
